// Prisma schema — CMS de Unidades / Locais de Atendimento (protótipo)
// Governo do Estado de Mato Grosso do Sul

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Municipio {
  id         Int    @id @default(autoincrement())
  nome       String
  uf         String
  slug       String @unique
  codigoIbge String?

  enderecos       Endereco[]
  orgaoEnderecos  OrgaoEndereco[]
}

model Orgao {
  id            Int      @id @default(autoincrement())
  nome          String
  sigla         String
  slug          String   @unique
  site          String?
  informacoes   String?
  orgaoExterno  Boolean  @default(false)
  ativo         Boolean  @default(true)
  // "Atendentes podem ser adicionados em mais de um local de atendimento?"
  atendenteMultiLocal      Boolean @default(false)
  ignoraRegrasAgendamento  Boolean @default(false)
  // "Identificador no controlador" — id do órgão no sistema legado
  identificadorControlador String?
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @default(now()) @updatedAt

  pontosAtendimento PontoAtendimento[]
  contato           OrgaoContato?
  canais            OrgaoCanalContato[]
  endereco          OrgaoEndereco?
  setores           Setor[]
  gestores          Gestor[]
  usuarios          OrgaoUsuario[]
  sites             SiteRelacionado[]
}

// Coleção "Cadastrar Órgãos": catálogo simples de órgãos (sigla, nome e
// situação). É independente de Orgao, que guarda os detalhes (contato,
// endereço, setores, gestores...) dos órgãos já em operação no CMS.
model OrgaoCadastro {
  id           Int      @id @default(autoincrement())
  sigla        String   @unique
  nome         String
  ativo        Boolean  @default(true)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @default(now()) @updatedAt
}

// Contato principal do órgão: responsável, telefone e e-mail. Os demais canais
// (WhatsApp, ouvidoria, redes...) ficam em OrgaoCanalContato, igual ao contato
// do local de atendimento.
model OrgaoContato {
  id          Int     @id @default(autoincrement())
  orgaoId     Int     @unique
  responsavel String?
  telefone    String
  email       String

  orgao Orgao @relation(fields: [orgaoId], references: [id], onDelete: Cascade)
}

model OrgaoCanalContato {
  id      Int    @id @default(autoincrement())
  orgaoId Int
  tipo    String
  rotulo  String
  valor   String

  orgao Orgao @relation(fields: [orgaoId], references: [id], onDelete: Cascade)
}

// Endereço + horários do órgão. O endereço do órgão é um único campo de texto
// livre (logradouro e número) e os horários de funcionamento e de atendimento
// ficam no próprio registro.
// bairro/cep/complemento não são mais editados no CMS — permanecem apenas para
// não descartar o que já havia sido cadastrado.
model OrgaoEndereco {
  id          Int     @id @default(autoincrement())
  orgaoId     Int     @unique
  municipioId Int
  logradouro  String
  complemento String?
  bairro      String?
  cep         String?
  sourceMapa  String
  // dias da semana como CSV (1=Segunda ... 7=Domingo), ex: "1,2,3,4,5"
  diasSemana   String
  temIntervalo Boolean @default(false)

  funcInicioManha String
  funcFimManha    String?
  funcInicioTarde String?
  funcFimTarde    String

  atendInicioManha String
  atendFimManha    String?
  atendInicioTarde String?
  atendFimTarde    String

  orgao     Orgao     @relation(fields: [orgaoId], references: [id], onDelete: Cascade)
  municipio Municipio @relation(fields: [municipioId], references: [id])
}

model Setor {
  id       Int      @id @default(autoincrement())
  orgaoId  Int
  sigla    String
  nome     String
  ativo    Boolean  @default(true)
  criadoEm DateTime @default(now())

  orgao Orgao @relation(fields: [orgaoId], references: [id], onDelete: Cascade)

  @@unique([orgaoId, sigla])
}

model Gestor {
  id        Int     @id @default(autoincrement())
  orgaoId   Int
  nome      String
  biografia String
  fotoUrl   String?
  ativo     Boolean @default(true)

  orgao Orgao @relation(fields: [orgaoId], references: [id], onDelete: Cascade)
}

model OrgaoUsuario {
  id       Int     @id @default(autoincrement())
  orgaoId  Int
  pessoaId Int
  perfil   String
  ativo    Boolean @default(true)

  orgao  Orgao  @relation(fields: [orgaoId], references: [id], onDelete: Cascade)
  pessoa Pessoa @relation(fields: [pessoaId], references: [id])

  @@unique([orgaoId, pessoaId])
}

model SiteRelacionado {
  id      Int     @id @default(autoincrement())
  orgaoId Int
  titulo  String
  link    String
  ativo   Boolean @default(true)

  orgao Orgao @relation(fields: [orgaoId], references: [id], onDelete: Cascade)
}

model TipoPonto {
  id            Int     @id @default(autoincrement())
  nome          String
  slug          String  @unique
  exigeEndereco Boolean @default(true)

  pontosAtendimento PontoAtendimento[]
}

model PontoAtendimento {
  id                    Int      @id @default(autoincrement())
  orgaoId               Int
  tipoPontoId           Int
  nome                  String
  slug                  String   @unique
  identificadorExterno  String?
  ativo                 Boolean  @default(true)
  criadoEm              DateTime @default(now())
  atualizadoEm          DateTime @updatedAt

  orgao      Orgao     @relation(fields: [orgaoId], references: [id])
  tipoPonto  TipoPonto @relation(fields: [tipoPontoId], references: [id])

  endereco     Endereco?
  responsaveis PontoResponsavel[]
  canais       CanalContato[]
  horarios     Horario[]
  servicos     ServicoUnidade[]
}

// Endereço do local de atendimento. Conforme a pesquisa, o formulário usa um
// único campo "Endereço" (logradouro + número) e um único campo "Source do mapa"
// (link de referência do Google Maps).
model Endereco {
  id                  Int     @id @default(autoincrement())
  pontoAtendimentoId  Int     @unique
  municipioId         Int
  logradouro          String
  complemento         String?
  bairro              String
  cep                 String
  sourceMapa          String

  pontoAtendimento PontoAtendimento @relation(fields: [pontoAtendimentoId], references: [id], onDelete: Cascade)
  municipio        Municipio        @relation(fields: [municipioId], references: [id])
}

model Pessoa {
  id   Int     @id @default(autoincrement())
  nome String
  cpf  String? @unique

  responsavelDe PontoResponsavel[]
  orgaos        OrgaoUsuario[]
}

model PontoResponsavel {
  pontoAtendimentoId Int
  pessoaId           Int
  cargo              String?

  pontoAtendimento PontoAtendimento @relation(fields: [pontoAtendimentoId], references: [id], onDelete: Cascade)
  pessoa           Pessoa           @relation(fields: [pessoaId], references: [id])

  @@id([pontoAtendimentoId, pessoaId])
}

model CanalContato {
  id                 Int    @id @default(autoincrement())
  pontoAtendimentoId Int
  tipo               String
  rotulo             String
  valor              String

  pontoAtendimento PontoAtendimento @relation(fields: [pontoAtendimentoId], references: [id], onDelete: Cascade)
}

// "Horário de funcionamento" (portas abertas) e "Horário de atendimento"
// (atendimento ao cidadão) — os dois campos pedidos na pesquisa.
model TipoHorario {
  id   Int    @id @default(autoincrement())
  nome String
  slug String @unique

  horarios Horario[]
}

// Horário reutilizável: cadastra-se uma vez e aplica-se a vários locais de
// atendimento de uma só vez (ex.: "07:30 às 17:30, seg a sex").
model ModeloHorario {
  id        Int      @id @default(autoincrement())
  nome      String   @unique
  descricao String?
  // períodos serializados (dias da semana, intervalo e horários), no mesmo
  // formato usado pelo formulário de unidade
  periodosJson String
  criadoEm     DateTime @default(now())
}

model Horario {
  id                 Int     @id @default(autoincrement())
  pontoAtendimentoId Int
  tipoHorarioId      Int
  diaSemana          Int
  inicio             String
  fim                String
  periodo            String?

  pontoAtendimento PontoAtendimento @relation(fields: [pontoAtendimentoId], references: [id], onDelete: Cascade)
  tipoHorario      TipoHorario      @relation(fields: [tipoHorarioId], references: [id])
}

model Servico {
  id   Int    @id @default(autoincrement())
  nome String

  unidades ServicoUnidade[]
}

model ServicoUnidade {
  pontoAtendimentoId Int
  servicoId          Int
  agendamento        Boolean @default(false)
  atendimento        Boolean @default(false)

  pontoAtendimento PontoAtendimento @relation(fields: [pontoAtendimentoId], references: [id], onDelete: Cascade)
  servico          Servico          @relation(fields: [servicoId], references: [id])

  @@id([pontoAtendimentoId, servicoId])
}
